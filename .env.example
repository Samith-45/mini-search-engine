# SearchForge Environment Configuration Example

# Backend Application Port
PORT=8080

# PostgreSQL Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/searchforgedb
SPRING_DATASOURCE_USERNAME=searchforge
SPRING_DATASOURCE_PASSWORD=searchforge_secret

# Redis Cache Configuration
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# Frontend Backend Proxy Target
BACKEND_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_SITE_URL=https://searchforge.dev
